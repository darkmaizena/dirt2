# Address the console connects to - set this to the machine's public/LAN IP.
DIRT2_ADVERTISED_ADDRESS=127.0.0.1

# SFTP ghost storage. Option 1 (Docker) configures the bundled sftpgo with these;
# Option 2 points them at your own SFTP server.
# USER/PASS must match sftpgo/init.json.
SFTP_PORT=2121
SFTP_USER=dirt
SFTP_PASS=dirt
